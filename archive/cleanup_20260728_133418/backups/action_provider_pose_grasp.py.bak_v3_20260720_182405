# -*- coding: utf-8 -*-
"""Robust R1-A7 + dual Dex1 cylinder grasp controller for Isaac Lab.

Fixes two problems seen in the runtime log:
1. Both physical finger joints are commanded explicitly from one logical
   gripper scalar, so the controller works even when the USD importer does
   not enforce the URDF mimic relation.
2. The grasp path approaches the cylinder from the current hand direction,
   not from the robot-root direction.  IK is solved for the Dex1 base link
   with a virtual grasp-center tool offset and position-only DLS IK.

State machine:
    WAIT -> OPEN -> PREGRASP -> APPROACH -> INSERT -> CLOSE -> LIFT -> HOLD
"""

from __future__ import annotations

from typing import Optional

import torch

from action_provider.action_base import ActionProvider
from isaaclab.controllers import DifferentialIKController
from isaaclab.controllers import DifferentialIKControllerCfg
from isaaclab.utils.math import quat_apply, subtract_frame_transforms


class PoseGraspActionProvider(ActionProvider):
    ARM_JOINT_NAMES = [
        "left_shoulder_pitch_joint",
        "left_shoulder_roll_joint",
        "left_shoulder_yaw_joint",
        "left_elbow_joint",
        "left_wrist_roll_joint",
        "left_wrist_pitch_joint",
        "left_wrist_yaw_joint",
    ]

    # Do not use the massless grasp-center dummy link as the Jacobian body.
    # The virtual tool point is reconstructed from a physical body plus offset.
    IK_BODY_CANDIDATES = (
        ("left_dex1_base_link", (0.0, 0.115, 0.0)),
        # wrist -> base: +0.0415 m in X, Rz(-90 deg), then base -> grasp:
        # +0.115 m in local Y.  Combined wrist-local offset is +0.1565 m in X.
        ("left_wrist_yaw_link", (0.1565, 0.0, 0.0)),
    )

    LEFT_GRIPPER_MASTER = "left_dex1_Joint1_1"
    LEFT_GRIPPER_SLAVE = "left_dex1_Joint2_1"
    RIGHT_GRIPPER_MASTER = "right_dex1_Joint1_1"
    RIGHT_GRIPPER_SLAVE = "right_dex1_Joint2_1"

    GRIPPER_OPEN = -0.018
    GRIPPER_CLOSE = 0.018

    # Approach distances are measured along the line from the current hand to
    # the object, which avoids generating an inner/unreachable pregrasp point.
    PREGRASP_DISTANCE = 0.18
    PREGRASP_Z_OFFSET = 0.06
    APPROACH_DISTANCE = 0.075
    APPROACH_Z_OFFSET = 0.015
    GRASP_STANDOFF = 0.012
    GRASP_Z_OFFSET = 0.0
    LIFT_HEIGHT = 0.10

    MAX_JOINT_STEP = 0.010
    PREGRASP_TOL = 0.020
    APPROACH_TOL = 0.015
    INSERT_TOL = 0.012
    LIFT_TOL = 0.020
    STABLE_STEPS = 12

    WAIT_TIME = 1.0
    OPEN_TIME = 1.0
    CLOSE_TIME = 2.0
    HOLD_TIME = 8.0
    PREGRASP_TIMEOUT = 15.0
    APPROACH_TIMEOUT = 12.0
    INSERT_TIMEOUT = 10.0
    LIFT_TIMEOUT = 12.0

    def __init__(self, env, args_cli):
        super().__init__("R1A7Dex1CylinderGraspFixed")

        self.env = env
        self.args_cli = args_cli
        self.robot = env.scene["robot"]
        self.object = env.scene["object"]
        self.device = env.device
        self.num_envs = env.num_envs

        if self.num_envs != 1:
            raise RuntimeError(
                "This validation controller requires num_envs=1, got "
                f"{self.num_envs}."
            )

        self.joint_names = list(self.robot.joint_names)
        self.body_names = list(self.robot.body_names)

        missing_arm = [
            name for name in self.ARM_JOINT_NAMES
            if name not in self.joint_names
        ]
        if missing_arm:
            raise RuntimeError(
                "Missing left-arm joints: "
                f"{missing_arm}\nLoaded joints: {self.joint_names}"
            )

        self.arm_ids = [
            self.joint_names.index(name)
            for name in self.ARM_JOINT_NAMES
        ]

        selected = next(
            (
                (name, offset)
                for name, offset in self.IK_BODY_CANDIDATES
                if name in self.body_names
            ),
            None,
        )
        if selected is None:
            raise RuntimeError(
                "No physical IK body was found. Tried "
                f"{[item[0] for item in self.IK_BODY_CANDIDATES]}.\n"
                f"Loaded bodies: {self.body_names}"
            )

        self.ik_body_name, tool_offset = selected
        self.ik_body_id = self.body_names.index(self.ik_body_name)
        self.ik_jacobian_id = (
            self.ik_body_id - 1
            if self.robot.is_fixed_base
            else self.ik_body_id
        )
        self.tool_offset_local = torch.tensor(
            tool_offset,
            dtype=torch.float32,
            device=self.device,
        ).view(1, 3).repeat(self.num_envs, 1)

        self.left_master_id = self._required_joint_id(
            self.LEFT_GRIPPER_MASTER
        )
        self.left_slave_id = self._required_joint_id(
            self.LEFT_GRIPPER_SLAVE
        )
        self.right_master_id = self._required_joint_id(
            self.RIGHT_GRIPPER_MASTER
        )
        self.right_slave_id = self._required_joint_id(
            self.RIGHT_GRIPPER_SLAVE
        )

        self.default_joint_pos = self.robot.data.default_joint_pos.clone()
        self.home_joint_pos = self.robot.data.joint_pos.clone()
        self._write_gripper_target(
            self.home_joint_pos,
            left=self.GRIPPER_OPEN,
            right=self.GRIPPER_OPEN,
        )

        # Position-only IK removes the initial straight-arm orientation lock
        # that prevented the arm from reaching the pregrasp waypoint.
        ik_cfg = DifferentialIKControllerCfg(
            command_type="position",
            use_relative_mode=False,
            ik_method="dls",
            ik_params={"lambda_val": 0.04},
        )
        self.ik = DifferentialIKController(
            ik_cfg,
            num_envs=self.num_envs,
            device=self.device,
        )

        self.control_dt = float(
            getattr(
                env,
                "step_dt",
                float(env.cfg.sim.dt) * int(env.cfg.decimation),
            )
        )

        self.initialized = False
        self.init_wait_steps = max(5, int(0.25 / self.control_dt))
        self.step_count = 0
        self.state = "BOOT"
        self.state_elapsed = 0.0
        self.stable_count = 0
        self.target_tool_pos = None
        self.last_log_time = -1.0

        self.initial_tool_pos = None
        self.initial_object_pose_w = None
        self.pregrasp_pos = None
        self.approach_pos = None
        self.grasp_pos = None
        self.lift_pos = None
        self.gripper_target = self.GRIPPER_OPEN

        print("\n" + "=" * 88)
        print("[R1-A7 GRASP FIX] controller constructed")
        print("[R1-A7 GRASP FIX] robot joint count:", len(self.joint_names))
        print("[R1-A7 GRASP FIX] action-manager dimension:", self._action_dim())
        print("[R1-A7 GRASP FIX] IK body:", self.ik_body_name)
        print("[R1-A7 GRASP FIX] tool offset local:", tool_offset)
        print("[R1-A7 GRASP FIX] arm ids:", self.arm_ids)
        print(
            "[R1-A7 GRASP FIX] gripper ids:",
            {
                "left_master": self.left_master_id,
                "left_slave": self.left_slave_id,
                "right_master": self.right_master_id,
                "right_slave": self.right_slave_id,
            },
        )
        print("=" * 88 + "\n")

    def _required_joint_id(self, name: str) -> int:
        if name not in self.joint_names:
            raise RuntimeError(
                f"Required joint is missing: {name}. "
                f"Loaded joints: {self.joint_names}"
            )
        return self.joint_names.index(name)

    def _action_dim(self):
        manager = getattr(self.env, "action_manager", None)
        if manager is None:
            return None
        for name in ("total_action_dim", "action_dim"):
            if hasattr(manager, name):
                return getattr(manager, name)
        return None

    def _root_pose_w(self) -> torch.Tensor:
        data = self.robot.data
        if hasattr(data, "root_link_pose_w"):
            return data.root_link_pose_w
        if hasattr(data, "root_pose_w"):
            return data.root_pose_w
        return data.root_state_w[:, 0:7]

    def _body_pose_w(self) -> torch.Tensor:
        data = self.robot.data
        if hasattr(data, "body_link_pose_w"):
            return data.body_link_pose_w
        if hasattr(data, "body_pose_w"):
            return data.body_pose_w
        return data.body_state_w[:, :, 0:7]

    def _object_pose_w(self) -> torch.Tensor:
        data = self.object.data
        if hasattr(data, "root_link_pose_w"):
            return data.root_link_pose_w
        if hasattr(data, "root_pose_w"):
            return data.root_pose_w
        return data.root_state_w[:, 0:7]

    def _ik_body_pose_b(self):
        root = self._root_pose_w()
        body = self._body_pose_w()[:, self.ik_body_id, :]
        return subtract_frame_transforms(
            root[:, 0:3],
            root[:, 3:7],
            body[:, 0:3],
            body[:, 3:7],
        )

    def _tool_pose_b(self):
        body_pos_b, body_quat_b = self._ik_body_pose_b()
        offset_b = quat_apply(body_quat_b, self.tool_offset_local)
        tool_pos_b = body_pos_b + offset_b
        return tool_pos_b, body_quat_b, offset_b

    def _object_pose_b(self):
        root = self._root_pose_w()
        obj = self._object_pose_w()
        return subtract_frame_transforms(
            root[:, 0:3],
            root[:, 3:7],
            obj[:, 0:3],
            obj[:, 3:7],
        )

    def _jacobian(self) -> torch.Tensor:
        view = (
            self.robot.root_view
            if hasattr(self.robot, "root_view")
            else self.robot.root_physx_view
        )
        jacobians = view.get_jacobians()
        return jacobians[
            :,
            self.ik_jacobian_id,
            :,
            self.arm_ids,
        ]

    def _write_gripper_target(
        self,
        desired: torch.Tensor,
        *,
        left: float,
        right: float,
    ) -> None:
        # The two physical sliders are explicitly synchronized.  This is one
        # logical action per gripper even though the imported USD has 21 joints.
        desired[:, self.left_master_id] = left
        desired[:, self.left_slave_id] = left
        desired[:, self.right_master_id] = right
        desired[:, self.right_slave_id] = right

    def _initialize_waypoints(self) -> None:
        tool_pos_b, _, _ = self._tool_pose_b()
        object_pos_b, _ = self._object_pose_b()

        if not torch.isfinite(tool_pos_b).all():
            raise RuntimeError("Tool pose contains NaN/Inf.")
        if not torch.isfinite(object_pos_b).all():
            raise RuntimeError("Cylinder pose contains NaN/Inf.")

        # Approach the cylinder from the current hand side.  The old code used
        # the root-to-object ray and generated [0.055, 0.185, ...], which was
        # inside the arm's awkward inner workspace.
        direction_xy = object_pos_b[:, 0:2] - tool_pos_b[:, 0:2]
        distance_xy = torch.linalg.norm(
            direction_xy,
            dim=-1,
            keepdim=True,
        ).clamp_min(1.0e-6)
        direction_xy = direction_xy / distance_xy

        pregrasp = object_pos_b.clone()
        pregrasp[:, 0:2] -= direction_xy * self.PREGRASP_DISTANCE
        pregrasp[:, 2] += self.PREGRASP_Z_OFFSET

        approach = object_pos_b.clone()
        approach[:, 0:2] -= direction_xy * self.APPROACH_DISTANCE
        approach[:, 2] += self.APPROACH_Z_OFFSET

        grasp = object_pos_b.clone()
        grasp[:, 0:2] -= direction_xy * self.GRASP_STANDOFF
        grasp[:, 2] += self.GRASP_Z_OFFSET

        lift = grasp.clone()
        lift[:, 2] += self.LIFT_HEIGHT

        self.initial_tool_pos = tool_pos_b.clone()
        self.initial_object_pose_w = self._object_pose_w().clone()
        self.pregrasp_pos = pregrasp
        self.approach_pos = approach
        self.grasp_pos = grasp
        self.lift_pos = lift

        self.initialized = True
        self._set_state("WAIT", self.initial_tool_pos)

        root = self._root_pose_w()[0]
        obj_w = self._object_pose_w()[0]
        obj_b = object_pos_b[0]
        tool_b = tool_pos_b[0]
        jacobian = self._jacobian()
        linear_norm = torch.linalg.norm(jacobian[:, 0:3, :]).item()
        angular_norm = torch.linalg.norm(jacobian[:, 3:6, :]).item()

        print("\n" + "=" * 88)
        print("[R1-A7 GRASP FIX] pose calibration")
        print("[R1-A7 GRASP FIX] robot root W xyz/quat:", root.tolist())
        print("[R1-A7 GRASP FIX] cylinder W xyz/quat:", obj_w.tolist())
        print("[R1-A7 GRASP FIX] cylinder B xyz:", obj_b.tolist())
        print("[R1-A7 GRASP FIX] tool center B xyz:", tool_b.tolist())
        print("[R1-A7 GRASP FIX] pregrasp B xyz:", pregrasp[0].tolist())
        print("[R1-A7 GRASP FIX] approach B xyz:", approach[0].tolist())
        print("[R1-A7 GRASP FIX] grasp B xyz:", grasp[0].tolist())
        print("[R1-A7 GRASP FIX] lift B xyz:", lift[0].tolist())
        print(
            "[R1-A7 GRASP FIX] Jacobian norms linear/angular:",
            f"{linear_norm:.6f}/{angular_norm:.6f}",
        )
        if linear_norm < 1.0e-5:
            raise RuntimeError(
                "The selected IK-body Jacobian is nearly zero. "
                "Check fixed-joint merging and body/Jacobian indexing."
            )
        print("=" * 88 + "\n")

    def _set_state(self, state: str, target_tool_pos: torch.Tensor) -> None:
        self.state = state
        self.state_elapsed = 0.0
        self.stable_count = 0
        self.target_tool_pos = target_tool_pos.clone()
        print(f"[R1-A7 GRASP FIX] >>> {state}")

    def _fail(self, reason: str) -> None:
        self.state = "FAIL"
        self.state_elapsed = 0.0
        self.stable_count = 0
        print(f"[R1-A7 GRASP FIX][FAIL] {reason}")

    def _reached(self, error: float, tolerance: float) -> bool:
        if error < tolerance:
            self.stable_count += 1
        else:
            self.stable_count = 0
        return self.stable_count >= self.STABLE_STEPS

    def _update_state(self, position_error: float) -> None:
        if self.state == "WAIT":
            if self.state_elapsed >= self.WAIT_TIME:
                self.gripper_target = self.GRIPPER_OPEN
                self._set_state("OPEN", self.initial_tool_pos)

        elif self.state == "OPEN":
            if self.state_elapsed >= self.OPEN_TIME:
                self._set_state("PREGRASP", self.pregrasp_pos)

        elif self.state == "PREGRASP":
            if self._reached(position_error, self.PREGRASP_TOL):
                self._set_state("APPROACH", self.approach_pos)
            elif self.state_elapsed >= self.PREGRASP_TIMEOUT:
                self._fail(
                    f"PREGRASP timeout, position error={position_error:.4f} m"
                )

        elif self.state == "APPROACH":
            if self._reached(position_error, self.APPROACH_TOL):
                self._set_state("INSERT", self.grasp_pos)
            elif self.state_elapsed >= self.APPROACH_TIMEOUT:
                self._fail(
                    f"APPROACH timeout, position error={position_error:.4f} m"
                )

        elif self.state == "INSERT":
            if self._reached(position_error, self.INSERT_TOL):
                self.gripper_target = self.GRIPPER_CLOSE
                self._set_state("CLOSE", self.grasp_pos)
            elif self.state_elapsed >= self.INSERT_TIMEOUT:
                self._fail(
                    f"INSERT timeout, position error={position_error:.4f} m"
                )

        elif self.state == "CLOSE":
            if self.state_elapsed >= self.CLOSE_TIME:
                self._set_state("LIFT", self.lift_pos)

        elif self.state == "LIFT":
            if self._reached(position_error, self.LIFT_TOL):
                self._set_state("HOLD", self.lift_pos)
            elif self.state_elapsed >= self.LIFT_TIMEOUT:
                self._fail(
                    f"LIFT timeout, position error={position_error:.4f} m"
                )

        elif self.state == "HOLD":
            if self.state_elapsed >= self.HOLD_TIME:
                self.state_elapsed = 0.0
                lift = self._object_lift_height()
                if lift >= 0.03:
                    print(
                        "[R1-A7 GRASP FIX][SUCCESS] cylinder lift height="
                        f"{lift:.4f} m"
                    )
                else:
                    print(
                        "[R1-A7 GRASP FIX][WARNING] cylinder lift is only "
                        f"{lift:.4f} m. Tune grasp offset, collision and friction."
                    )

    def _object_lift_height(self) -> float:
        if self.initial_object_pose_w is None:
            return 0.0
        return float(
            (
                self._object_pose_w()[0, 2]
                - self.initial_object_pose_w[0, 2]
            ).item()
        )

    def get_action(self, env) -> Optional[torch.Tensor]:
        del env
        self.step_count += 1

        if not self.initialized:
            current = self.robot.data.joint_pos.clone()
            self._write_gripper_target(
                current,
                left=self.GRIPPER_OPEN,
                right=self.GRIPPER_OPEN,
            )
            if self.step_count >= self.init_wait_steps:
                self._initialize_waypoints()
            return current - self.default_joint_pos

        self.state_elapsed += self.control_dt

        body_pos_b, body_quat_b = self._ik_body_pose_b()
        tool_pos_b, _, offset_b = self._tool_pose_b()
        current = self.robot.data.joint_pos
        current_arm = current[:, self.arm_ids]

        if self.state == "FAIL":
            desired = current.clone()
            self._write_gripper_target(
                desired,
                left=self.GRIPPER_OPEN,
                right=self.GRIPPER_OPEN,
            )
            return desired - self.default_joint_pos

        # Convert the desired virtual grasp-center position into the required
        # physical IK-body origin position using the current tool orientation.
        target_body_pos = self.target_tool_pos - offset_b
        self.ik.set_command(
        target_body_pos,
        ee_quat=body_quat_b,
        )

        desired_arm = self.ik.compute(
            body_pos_b,
            body_quat_b,
            self._jacobian(),
            current_arm,
        )
        desired_arm = torch.nan_to_num(
            desired_arm,
            nan=0.0,
            posinf=0.0,
            neginf=0.0,
        )

        delta = torch.clamp(
            desired_arm - current_arm,
            min=-self.MAX_JOINT_STEP,
            max=self.MAX_JOINT_STEP,
        )
        desired_arm = current_arm + delta

        limits = getattr(self.robot.data, "soft_joint_pos_limits", None)
        if limits is not None:
            arm_limits = limits[:, self.arm_ids, :]
            desired_arm = torch.maximum(
                desired_arm,
                arm_limits[..., 0] + 0.01,
            )
            desired_arm = torch.minimum(
                desired_arm,
                arm_limits[..., 1] - 0.01,
            )

        desired = self.home_joint_pos.clone()
        desired[:, self.arm_ids] = desired_arm
        self._write_gripper_target(
            desired,
            left=self.gripper_target,
            right=self.GRIPPER_OPEN,
        )
        action = desired - self.default_joint_pos

        action_dim = self._action_dim()
        if action_dim is not None and int(action_dim) != int(action.shape[1]):
            raise RuntimeError(
                "Action dimension mismatch: provider returns "
                f"{action.shape[1]}, action manager expects {action_dim}."
            )

        position_error = float(
            torch.linalg.norm(
                self.target_tool_pos - tool_pos_b,
                dim=-1,
            )[0].item()
        )
        self._update_state(position_error)

        simulation_time = self.step_count * self.control_dt
        if simulation_time - self.last_log_time >= 0.5:
            self.last_log_time = simulation_time
            object_pos_b, _ = self._object_pose_b()
            q = self.robot.data.joint_pos[0]
            print(
                f"[R1-A7 GRASP FIX] state={self.state:<9} "
                f"t={self.state_elapsed:5.2f}s "
                f"err={position_error:.4f}m "
                f"tool_B={tool_pos_b[0].tolist()} "
                f"target_B={self.target_tool_pos[0].tolist()} "
                f"obj_B={object_pos_b[0].tolist()} "
                f"left_fingers=[{float(q[self.left_master_id]):+.4f},"
                f"{float(q[self.left_slave_id]):+.4f}] "
                f"obj_lift={self._object_lift_height():.4f}m"
            )

        return action

    def cleanup(self):
        print("[R1-A7 GRASP FIX] provider cleanup")
