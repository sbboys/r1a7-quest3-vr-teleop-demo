# ============================================================
# HELPERS
# ============================================================

def clip(
    value,
    limit,
):

    return float(
        np.clip(
            float(value),
            -float(limit),
            float(limit),
        )
    )


def axis_command(
    error_px,
    kp,
    sign,
):

    if (
        error_px is None
        or
        not np.isfinite(
            error_px
        )
    ):
        return 0.0

    if (
        abs(
            float(error_px)
        )
        <=
        DEADBAND_PX
    ):
        return 0.0

    return clip(
        sign
        *
        kp
        *
        float(error_px),
        MAX_AXIS_MM_S,
    )


def atomic_json(
    path,
    data,
):

    tmp = Path(
        str(path)
        + ".tmp"
    )

    tmp.write_text(
        json.dumps(
            data,
            indent=2,
        )
    )

    os.replace(
        tmp,
        path,
    )


def copy_dict_arrays(
    src,
):

    if src is None:
        return None

    out = {}

    for k, v in (
        src.items()
    ):

        if isinstance(
            v,
            np.ndarray,
        ):

            out[k] = (
                v.copy()
            )

        else:

            out[k] = v

    return out


def uv_from_yx(
    point_yx,
):

    if point_yx is None:
        return None

    return [
        float(
            point_yx[1]
        ),
        float(
            point_yx[0]
        ),
    ]


def calculate_error(
    tip_result,
    geometry,
):

    if (
        tip_result is None
        or
        not tip_result.get(
            "valid",
            False,
        )
    ):
        return None

    grasp_yx = geometry.get(
        "grasp_point_yx"
    )

    tip_yx = tip_result.get(
        "tip_yx"
    )

    if (
        grasp_yx is None
        or
        tip_yx is None
    ):
        return None

    gu = float(
        grasp_yx[1]
    )

    gv = float(
        grasp_yx[0]
    )

    tu = float(
        tip_yx[1]
    )

    tv = float(
        tip_yx[0]
    )

    # Target - current.
    du = gu - tu
    dv = gv - tv

    return {
        "tip_uv":
            [
                tu,
                tv,
            ],

        "grasp_uv":
            [
                gu,
                gv,
            ],

        "du":
            float(du),

        "dv":
            float(dv),

        "norm":
            float(
                np.hypot(
                    du,
                    dv,
                )
            ),
    }


# ============================================================
# EXTERNAL GUIDANCE
#
# GitHub verified mapping:
#
# image +U -> robot +X
# image +V -> robot -Z
# ============================================================

def publish_external(
    locked,
    track,
    geometry,
    tip_result,
):

    now = time.time()

    err = calculate_error(
        tip_result,
        geometry,
    )

    valid = bool(
        locked
        and
        err is not None
        and
        tip_result.get(
            "valid",
            False,
        )
    )

    if valid:

        du = err["du"]
        dv = err["dv"]

        vx = axis_command(
            du,
            KP_EXT_X,
            +1.0,
        )

        vz = axis_command(
            dv,
            KP_EXT_Z,
            -1.0,
        )

    else:

        du = None
        dv = None

        vx = 0.0
        vz = 0.0

    out = {
        "timestamp":
            now,

        # SHADOW ONLY.
        "enabled":
            False,

        "shadow_mode":
            True,

        "source":
            "current_v3_external_locked_wire_live_tip",

        "guidance_valid":
            valid,

        "wire_locked":
            bool(
                locked
            ),

        "track_state":
            (
                track.get(
                    "state"
                )
                if track
                is not None
                else None
            ),

        "tweezer_tip_uv":
            (
                err["tip_uv"]
                if valid
                else None
            ),

        "grasp_target_uv":
            (
                err["grasp_uv"]
                if valid
                else None
            ),

        "du_px":
            du,

        "dv_px":
            dv,

        "error_norm_px":
            (
                err["norm"]
                if valid
                else None
            ),

        # AUTO_GRASP_VISUAL_FIELDS_V1
        "tip_grasp_distance_px":
            (
                float(tip_result["tip_grasp_distance_px"])
                if (
                    valid
                    and
                    tip_result.get("tip_grasp_distance_px") is not None
                )
                else None
            ),

        "tool_pixels":
            (
                int(tip_result.get("tool_pixels", 0))
                if valid
                else 0
            ),

        "front_pixels":
            (
                int(tip_result.get("front_pixels", 0))
                if valid
                else 0
            ),

        "axis_ratio":
            (
                float(tip_result["axis_ratio"])
                if (
                    valid
                    and
                    tip_result.get("axis_ratio") is not None
                )
                else None
            ),

        "tip_status":
            tip_result.get("status"),

        "proposed_vx_mm_s":
            float(vx),

        "proposed_vy_mm_s":
            0.0,

        "proposed_vz_mm_s":
            float(vz),
    }

    atomic_json(
        EXTERNAL_OUT,
        out,
    )

    return out


# ============================================================
# RIGHT WRIST GUIDANCE
#
# Latest GitHub mapping:
#
# image +U -> robot -Y
# image +V -> robot -Z
# ============================================================

def publish_wrist(
    calibrated,
    track,
    geometry,
    tip_result,
):

    now = time.time()

    err = calculate_error(
        tip_result,
        geometry,
    )

    track_state = (
        track.get(
            "state"
        )
        if track
        is not None
        else None
    )

    # Important:
    # HOLD / RESET / LOST are NOT accepted as a new control
    # measurement.
    live_state_ok = (
        track_state
        in (
            "INIT",
            "TRACK",
            "RECOVER",
        )
    )

    geometry_ok = bool(
        geometry.get(
            "measurement_valid",
            False,
        )
    )

    valid = bool(
        calibrated
        and
        live_state_ok
        and
        geometry_ok
        and
        err is not None
        and
        tip_result.get(
            "valid",
            False,
        )
    )

    if valid:

        du = err["du"]
        dv = err["dv"]

        vy = axis_command(
            du,
            KP_WRIST_Y,
            -1.0,
        )

        vz = axis_command(
            dv,
            KP_WRIST_Z,
            -1.0,
        )

    else:

        du = None
        dv = None

        vy = 0.0
        vz = 0.0

    out = {
        "timestamp":
            now,

        # SHADOW ONLY.
        "enabled":
            False,

        "shadow_mode":
            True,

        "source":
            "current_v3_right_wrist_live_wire_live_tip",

        "guidance_valid":
            valid,

        "track_state":
            track_state,

        "geometry_status":
            geometry.get(
                "status"
            ),

        "tweezer_grasp_center_uv":
            (
                err["tip_uv"]
                if valid
                else None
            ),

        "tweezer_tip_uv":
            (
                err["tip_uv"]
                if valid
                else None
            ),

        "grasp_target_uv":
            (
                err["grasp_uv"]
                if valid
                else None
            ),

        "du_px":
            du,

        "dv_px":
            dv,

        "error_norm_px":
            (
                err["norm"]
                if valid
                else None
            ),

        # AUTO_GRASP_VISUAL_FIELDS_V1
        "tip_grasp_distance_px":
            (
                float(tip_result["tip_grasp_distance_px"])
                if (
                    valid
                    and
                    tip_result.get("tip_grasp_distance_px") is not None
                )
                else None
            ),

        "tool_pixels":
            (
                int(tip_result.get("tool_pixels", 0))
                if valid
                else 0
            ),

        "front_pixels":
            (
                int(tip_result.get("front_pixels", 0))
                if valid
                else 0
            ),

        "axis_ratio":
            (
                float(tip_result["axis_ratio"])
                if (
                    valid
                    and
                    tip_result.get("axis_ratio") is not None
                )
                else None
            ),

        "tip_status":
            tip_result.get("status"),

        "proposed_vx_mm_s":
            0.0,

        "proposed_vy_mm_s":
            float(vy),

        "proposed_vz_mm_s":
            float(vz),
    }

    atomic_json(
        WRIST_OUT,
        out,
    )

    return out


