def draw_guidance(
    image,
    result,
    camera,
):

    y0 = 178

    if not result.get(
        "guidance_valid",
        False,
    ):

        text = (
            "GUIDANCE: INVALID / SHADOW"
        )

        cv2.putText(
            image,
            text,
            (
                12,
                y0,
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.46,
            (
                0,
                165,
                255,
            ),
            1,
            cv2.LINE_AA,
        )

        return image

    du = result[
        "du_px"
    ]

    dv = result[
        "dv_px"
    ]

    if camera == "external":

        line1 = (
            f"GUIDE SHADOW  "
            f"du={du:+.1f}  "
            f"dv={dv:+.1f}"
        )

        line2 = (
            f"vx={result['proposed_vx_mm_s']:+.2f}  "
            f"vz={result['proposed_vz_mm_s']:+.2f} "
            f"mm/s"
        )

    else:

        line1 = (
            f"GUIDE SHADOW  "
            f"du={du:+.1f}  "
            f"dv={dv:+.1f}"
        )

        line2 = (
            f"vy={result['proposed_vy_mm_s']:+.2f}  "
            f"vz={result['proposed_vz_mm_s']:+.2f} "
            f"mm/s"
        )

    cv2.putText(
        image,
        line1,
        (
            12,
            y0,
        ),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.45,
        (
            255,
            255,
            255,
        ),
        1,
        cv2.LINE_AA,
    )

    cv2.putText(
        image,
        line2,
        (
            12,
            y0 + 24,
        ),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.45,
        (
            0,
            255,
            255,
        ),
        1,
        cv2.LINE_AA,
    )

    return image


