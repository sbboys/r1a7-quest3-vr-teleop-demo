def main():

    print(
        "=" * 90
    )

    print(
        "R1-A7 GRASP -> INSERTION VISUAL V1"
    )

    print(
        "=" * 90
    )

    print(
        "GRASP:"
    )

    print(
        "  existing validated Wire/TIP guidance unchanged"
    )

    print(
        "AFTER CLOSE:"
    )

    print(
        "  arm stops; Hole U-Net starts; all wire cameras become LIVE"
    )

    print(
        "  click SAME physical hole in External / Right Wrist / Left Wrist"
    )

    print(
        "  after 3 targets: RIGHT CLICK to confirm (ENTER / SPACE / E also work)"
    )

    print(
        "INSERTION:"
    )

    print(
        "  External FREE -> HOLE controls X/Z"
    )

    print(
        "  Left Wrist FREE -> HOLE controls coupled Y/Z"
    )

    print(
        "  Right Wrist is monitoring only during insertion"
    )

    print(
        "  FREE temporary loss -> TIP-relative FREE prediction at reduced speed"
    )

    print(
        "R = reselect hole and STOP insertion"
    )

    print(
        "P = print current insertion state"
    )

    print(
        "Q / ESC = quit"
    )

    print(
        "=" * 90
    )


    # --------------------------------------------------------
    # Existing wire models
    # --------------------------------------------------------

    # WIRE_V4_HOLE_V2_RUNTIME_INTEGRATION_V1
    #
    # Reuse the existing validated device initialization, but replace
    # the actual inference model for all three cameras with Wire V5.
    _legacy_model, device = (
        grasp.base.load_model()
    )

    model = (
        grasp.load_model_from_checkpoint(
            WIRE_V4_CHECKPOINT,
            device,
        )
    )

    model_right_wrist = (
        grasp.load_model_from_checkpoint(
            WIRE_V4_CHECKPOINT,
            device,
        )
    )

    del _legacy_model

    print(
        "[MODEL] Wire V5 all cameras =",
        WIRE_V4_CHECKPOINT,
    )

    print(
        "[MODEL] Hole V3 after CLOSE =",
        HOLE_CHECKPOINT,
    )


    # Hole model is intentionally lazy-loaded only after CLOSE.
    hole_model = None
    hole_device = None


    temporal_trackers = {
        camera:
            grasp.temporal.TemporalTracker(
                camera
            )
        for camera
        in CAMERA_ORDER
    }


    free_trackers = {
        camera:
            grasp.manual.ManualFreeTracker(
                camera
            )
        for camera
        in CAMERA_ORDER
    }


    tip_trackers = {}

    for camera in CAMERA_ORDER:

        if camera == "right_wrist":

            tip_trackers[
                camera
            ] = (
                grasp.wrist_tip_mid.
                RightWristTweezerTipMidpointV1(
                    camera
                )
            )

        else:

            tip_trackers[
                camera
            ] = (
                grasp.TweezerTipTracker(
                    camera
                )
            )


    locked = {
        "external":
            False,

        "left_wrist":
            False,
    }


    locked_tracks = {
        "external":
            None,

        "left_wrist":
            None,
    }


    locked_geometry = {
        "external":
            None,

        "left_wrist":
            None,
    }


    latest_tracks = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }


    latest_shapes = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }


    latest_holes = {
        camera:
            []
        for camera
        in CAMERA_ORDER
    }


    latest_hole_pred = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }


    target_selected = {
        camera:
            False
        for camera
        in CAMERA_ORDER
    }


    target_uv = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }


    target_valid = {
        camera:
            False
        for camera
        in CAMERA_ORDER
    }


    target_update_time = {
        camera:
            0.0
        for camera
        in CAMERA_ORDER
    }


    tip_free_samples = {
        camera:
            collections.deque(
                maxlen=
                    TIP_FREE_REFERENCE_SAMPLES
            )
        for camera
        in CAMERA_ORDER
    }


    last_measured_free_time = {
        camera:
            0.0
        for camera
        in CAMERA_ORDER
    }


    # INSERTION_MEASUREMENT_FRESHNESS_V1
    insertion_free_measurement_time = {
        camera:
            0.0
        for camera
        in CAMERA_ORDER
    }

    insertion_hole_measurement_time = {
        camera:
            0.0
        for camera
        in CAMERA_ORDER
    }


    # FREE_CONTROL_HOLD_V1
    last_control_free_uv = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }

    last_control_free_time = {
        camera:
            0.0
        for camera
        in CAMERA_ORDER
    }


    # INSERTION_VISUAL_STABILITY_V1
    free_filtered_uv = {
        camera:
            None
        for camera
        in CAMERA_ORDER
    }


    latest_free_guidance = {
        camera:
            {
                "uv":
                    None,

                "source":
                    None,

                "tip_uv":
                    None,
            }
        for camera
        in CAMERA_ORDER
    }


    panel_layout = {}

    phase = (
        PHASE_GRASP
    )

    target_confirmed = False

    latest_external_guidance = {}
    latest_wrist_guidance = {}


    # --------------------------------------------------------
    # Mouse callback
    # --------------------------------------------------------

    def on_mouse(
        event,
        x,
        y,
        flags,
        param,
    ):

        nonlocal target_confirmed
        nonlocal phase


        # ====================================================
        # RIGHT CLICK:
        # confirm the three already-selected target holes.
        #
        # This avoids depending on keyboard focus.  The user
        # can select all 3 targets and then right-click anywhere
        # inside the OpenCV visual window.
        # ====================================================

        if (
            event
            ==
            cv2.EVENT_RBUTTONDOWN
        ):

            if phase != PHASE_WAIT_HOLE:

                return


            # OPTIONAL_CONTROL_CAMERA_HOLE_SELECTION_V1
            #
            # At least one REAL insertion-control camera must
            # have a manually selected and currently valid hole.
            #
            # Left Wrist is optional and never starts insertion
            # by itself.

            control_ready_cameras = [
                camera_name
                for camera_name
                in INSERTION_CONTROL_CAMERAS
                if (
                    target_selected[
                        camera_name
                    ]
                    and
                    target_uv[
                        camera_name
                    ]
                    is not None
                    and
                    target_valid[
                        camera_name
                    ]
                )
            ]


            if len(control_ready_cameras) == len(INSERTION_CONTROL_CAMERAS):

                target_confirmed = True

                phase = (
                    PHASE_INSERTION
                )

                print()
                print(
                    "=" * 90
                )

                print(
                    "[PHASE] WAIT_HOLE_TARGET -> INSERTION_TRACKING"
                )

                print(
                    "[CONFIRM] insertion target confirmed by RIGHT CLICK"
                )

                print(
                    "[PHASE] External + Left Wrist FREE->HOLE guidance ENABLED"
                )

                print(
                    "=" * 90
                )
                print()

            else:

                print(
                    "[HOLE CONFIRM] RIGHT CLICK rejected: "
                    "select target hole in all 3 views first"
                )


            return


        if (
            event
            !=
            cv2.EVENT_LBUTTONDOWN
        ):
            return


        camera = None
        local_x = None
        local_y = None

        for name in CAMERA_ORDER:

            layout = (
                panel_layout.get(
                    name
                )
            )

            if layout is None:
                continue

            if (
                layout["x0"]
                <=
                x
                <
                layout["x1"]

                and

                0
                <=
                y
                <
                layout["h"]
            ):

                camera = name

                local_x = (
                    x
                    -
                    layout["x0"]
                )

                local_y = y

                break


        if camera is None:
            return


        shape = latest_shapes.get(
            camera
        )

        if shape is None:
            return


        layout = panel_layout[
            camera
        ]

        h = int(
            shape[0]
        )

        w = int(
            shape[1]
        )

        native_x = float(
            np.clip(
                local_x
                *
                w
                /
                layout["w"],
                0,
                w - 1,
            )
        )

        native_y = float(
            np.clip(
                local_y
                *
                h
                /
                layout["h"],
                0,
                h - 1,
            )
        )


        # ====================================================
        # GRASP PHASE:
        # Same FREE initialization/locking semantics.
        # ====================================================

        if phase == PHASE_GRASP:

            track = (
                latest_tracks.get(
                    camera
                )
            )

            if track is None:
                return

            if (
                camera
                in FIXED_WIRE_CAMERAS
                and
                locked[
                    camera
                ]
            ):

                print(
                    f"[{camera}] already locked"
                )

                return


            state = track.get(
                "state"
            )

            if state not in (
                "INIT",
                "TRACK",
                "RECOVER",
            ):

                print(
                    f"[{camera}] FREE calibration rejected state={state}"
                )

                return


            path = track.get(
                "path"
            )

            if path is None:
                return


            tracker = (
                free_trackers[
                    camera
                ]
            )

            tracker.current_shape = (
                path.shape
            )

            ok = tracker.calibrate(
                path,
                (
                    int(
                        round(
                            native_y
                        )
                    ),
                    int(
                        round(
                            native_x
                        )
                    ),
                ),
            )

            if not ok:

                print(
                    f"[{camera}] FREE calibration failed"
                )

                return


            if (
                camera
                in FIXED_WIRE_CAMERAS
            ):

                lt = copy.deepcopy(
                    track
                )

                lt[
                    "state"
                ] = "LOCKED"

                geometry = copy.deepcopy(
                    tracker.last_geometry
                )

                if geometry is None:

                    print(
                        f"[{camera}] no geometry after calibration"
                    )

                    return


                geometry[
                    "state"
                ] = "LOCKED"

                geometry[
                    "status"
                ] = "LOCKED_WIRE_REFERENCE"

                geometry[
                    "measurement_valid"
                ] = False

                geometry[
                    "display_valid"
                ] = True


                locked[
                    camera
                ] = True

                locked_tracks[
                    camera
                ] = lt

                locked_geometry[
                    camera
                ] = geometry


                latest_tracks[
                    camera
                ] = lt


                print(
                    f"[{camera}] WIRE/FREE/GRASP LOCKED"
                )

            else:

                print(
                    "[right_wrist] FREE identity initialized; LIVE tracking"
                )


            return


        # ====================================================
        # HOLE SELECTION PHASE
        # ====================================================

        holes = (
            latest_holes.get(
                camera,
                [],
            )
        )

        hole, distance = (
            nearest_hole(
                holes,
                (
                    native_x,
                    native_y,
                ),
            )
        )

        if (
            hole is None
            or
            distance
            >
            HOLE_CLICK_MAX_PX
        ):

            print(
                f"[HOLE SELECT] {camera}: no hole near click "
                f"d={distance:.1f}px"
            )

            return


        center = hole[
            "center_uv"
        ]

        target_selected[
            camera
        ] = True

        target_uv[
            camera
        ] = (
            float(
                center[0]
            ),
            float(
                center[1]
            ),
        )

        # DYNAMIC_SELECTED_HOLE_TRACK_V1
        # Preserve the raw selected-hole measurement separately from
        # the smoothed target_uv used by insertion guidance.
        latest_holes[
            camera
        ] = [
            hole
        ]

        target_valid[
            camera
        ] = True

        target_update_time[
            camera
        ] = time.time()

        # INSERTION_MEASUREMENT_FRESHNESS_V1
        insertion_hole_measurement_time[
            camera
        ] = time.time()

        target_confirmed = False


        print(
            f"[HOLE SELECT] {camera}: "
            f"target=({center[0]:.1f},{center[1]:.1f}) "
            f"click_distance={distance:.1f}px"
        )


    # --------------------------------------------------------
    # Cameras
    # --------------------------------------------------------

    external = None
    right = None
    left = None

    frame_counter = 0

    # INSERTION_DATASET_RECORDER_INTEGRATION_V1
    #
    # Recorder is inactive during GRASP.
    # A session starts automatically in:
    #   WAIT_HOLE_TARGET
    #   INSERTION_TRACKING
    #
    # Normal frames: 5 Hz
    # Event frames:  10 Hz + immediate state transitions
    dataset_recorder = (
        insertion_recorder.InsertionDatasetRecorder(
            normal_hz=5.0,
            event_hz=10.0,
            jpeg_quality=95,
            max_queue=128,
        )
    )

    print(
        "[DATA RECORDER] initialized",
        flush=True,
    )
    last_print = 0.0


    try:

        external = (
            grasp.base.open_external()
        )

        ctx = (
            grasp.base.Context()
        )

        right = (
            grasp.base.open_orbbec(
                ctx,
                grasp.base.RIGHT_SERIAL,
            )
        )

        left = (
            grasp.base.open_orbbec(
                ctx,
                grasp.base.LEFT_SERIAL,
            )
        )


        time.sleep(
            1.0
        )


        cv2.namedWindow(
            WINDOW,
            cv2.WINDOW_AUTOSIZE,
        )

        cv2.setMouseCallback(
            WINDOW,
            on_mouse,
        )


        while True:

            now = time.time()

            frame_counter += 1


            ok_ext, frame_ext = (
                external.read()
            )

            frame_right = (
                grasp.base.read_orbbec(
                    right
                )
            )

            frame_left = (
                grasp.base.read_orbbec(
                    left
                )
            )


            if (
                not ok_ext
                or
                frame_right
                is None
                or
                frame_left
                is None
            ):

                continue


            frames = {
                "external":
                    frame_ext,

                "right_wrist":
                    frame_right,

                "left_wrist":
                    frame_left,
            }


            detections = {}
            fps_values = {}


            # ------------------------------------------------
            # Wire + tool segmentation always stays live.
            # ------------------------------------------------

            for camera in CAMERA_ORDER:

                active_model = (
                    model_right_wrist
                    if
                    camera
                    ==
                    "right_wrist"
                    else
                    model
                )

                (
                    detections[
                        camera
                    ],
                    fps_values[
                        camera
                    ],
                ) = (
                    grasp.base.run_one(
                        active_model,
                        device,
                        frames[
                            camera
                        ],
                    )
                )


            tracks = {}
            geometries = {}


            # =================================================
            # GRASP:
            # Preserve existing External/Left frozen-wire logic.
            # =================================================

            if phase == PHASE_GRASP:

                for camera in (
                    "external",
                    "left_wrist",
                ):

                    if locked[
                        camera
                    ]:

                        tracks[
                            camera
                        ] = (
                            locked_tracks[
                                camera
                            ]
                        )

                        geometries[
                            camera
                        ] = (
                            locked_geometry[
                                camera
                            ]
                        )

                    else:

                        tracks[
                            camera
                        ] = (
                            temporal_trackers[
                                camera
                            ].update(
                                detections[
                                    camera
                                ]
                            )
                        )

                        geometries[
                            camera
                        ] = (
                            free_trackers[
                                camera
                            ].update(
                                tracks[
                                    camera
                                ]
                            )
                        )


                camera = (
                    "right_wrist"
                )

                tracks[
                    camera
                ] = (
                    temporal_trackers[
                        camera
                    ].update(
                        detections[
                            camera
                        ]
                    )
                )

                geometries[
                    camera
                ] = (
                    free_trackers[
                        camera
                    ].update(
                        tracks[
                            camera
                        ]
                    )
                )


            # =================================================
            # INSERTION:
            # All three wire/FREE trackers become LIVE.
            # =================================================

            else:

                for camera in CAMERA_ORDER:

                    tracks[
                        camera
                    ] = (
                        temporal_trackers[
                            camera
                        ].update(
                            detections[
                                camera
                            ]
                        )
                    )

                    geometries[
                        camera
                    ] = (
                        free_trackers[
                            camera
                        ].update(
                            tracks[
                                camera
                            ]
                        )
                    )


            for camera in CAMERA_ORDER:

                latest_tracks[
                    camera
                ] = tracks[
                    camera
                ]

                latest_shapes[
                    camera
                ] = frames[
                    camera
                ].shape


            # ------------------------------------------------
            # TIP
            # ------------------------------------------------

            tip_results = {}

            for camera in CAMERA_ORDER:

                grasp_yx = (
                    geometries[
                        camera
                    ].get(
                        "grasp_point_yx"
                    )
                    if
                    geometries[
                        camera
                    ]
                    is not None
                    else
                    None
                )

                tip_results[
                    camera
                ] = (
                    tip_trackers[
                        camera
                    ].update(
                        detections[
                            camera
                        ][
                            "tool_mask"
                        ],
                        grasp_yx,
                    )
                )


            # =================================================
            # GRASP GUIDANCE:
            # Reuse exact validated functions.
            # =================================================

            if phase == PHASE_GRASP:

                latest_external_guidance = (
                    grasp.publish_external(
                        locked[
                            "external"
                        ],
                        tracks[
                            "external"
                        ],
                        geometries[
                            "external"
                        ],
                        tip_results[
                            "external"
                        ],
                    )
                )


                latest_wrist_guidance = (
                    grasp.publish_wrist(
                        free_trackers[
                            "right_wrist"
                        ].calibrated,
                        tracks[
                            "right_wrist"
                        ],
                        geometries[
                            "right_wrist"
                        ],
                        tip_results[
                            "right_wrist"
                        ],
                    )
                )


                # WRIST_JAW_CORRIDOR_V1
                #
                # Add physical open-jaw corridor information
                # to the existing Right Wrist guidance JSON.
                latest_wrist_guidance = (
                    augment_wrist_jaw_corridor(
                        latest_wrist_guidance,
                        tip_results[
                            "right_wrist"
                        ],
                        geometries[
                            "right_wrist"
                        ],
                    )
                )

                atomic_json(
                    grasp.WRIST_OUT,
                    latest_wrist_guidance,
                )


                atomic_json(
                    TARGET_STATE_OUT,
                    {
                        "timestamp":
                            now,

                        "phase":
                            PHASE_GRASP,

                        "target_ready":
                            False,

                        "target_confirmed":
                            False,
                    },
                )


                # --------------------------------------------
                # CLOSE -> WAIT_HOLE_TARGET transition
                # --------------------------------------------

                if close_completed_signal():

                    print()
                    print(
                        "=" * 90
                    )

                    print(
                        "[PHASE] GRASP -> WAIT_HOLE_TARGET"
                    )

                    print(
                        "[PHASE] arm guidance disabled; gripper remains closed"
                    )

                    print(
                        "[PHASE] External + Left wire locks RELEASED"
                    )

                    print(
                        "[PHASE] loading Hole U-Net..."
                    )

                    print(
                        "=" * 90
                    )


                    phase = (
                        PHASE_WAIT_HOLE
                    )

                    target_confirmed = False


                    for camera in (
                        "external",
                        "left_wrist",
                    ):

                        locked[
                            camera
                        ] = False

                        locked_tracks[
                            camera
                        ] = None

                        locked_geometry[
                            camera
                        ] = None

                        # Reset temporal path history, but preserve
                        # ManualFreeTracker identity/calibration.
                        temporal_trackers[
                            camera
                        ] = (
                            grasp.temporal.TemporalTracker(
                                camera
                            )
                        )


                    invalid_guidance(
                        "external",
                        phase,
                        "WAITING_FOR_HOLE_SELECTION",
                    )

                    invalid_guidance(
                        "left_wrist",
                        phase,
                        "WAITING_FOR_HOLE_SELECTION",
                    )


                    atomic_json(
                        TARGET_STATE_OUT,
                        {
                            "timestamp":
                                time.time(),

                            "phase":
                                phase,

                            "target_ready":
                                False,

                            "target_confirmed":
                                False,
                        },
                    )


                    if hole_model is None:

                        (
                            hole_model,
                            hole_device,
                        ) = (
                            hole_live.load_model(
                                HOLE_CHECKPOINT
                            )
                        )


                    print()
                    print(
                        "[HOLE] detector ready"
                    )

                    print(
                        "[HOLE] click SAME physical hole in all 3 views"
                    )

                    print(
                        "[HOLE] then press ENTER"
                    )

                    print()


            # =================================================
            # WAIT_HOLE / INSERTION
            # =================================================

            else:

                # --------------------------------------------
                # Hole inference
                # --------------------------------------------

                if (
                    hole_model
                    is not None
                    and
                    frame_counter
                    %
                    HOLE_EVERY
                    ==
                    0
                ):

                    for camera in CAMERA_ORDER:

                        try:

                            pred = (
                                hole_live.predict_sliding(
                                    hole_model,
                                    frames[
                                        camera
                                    ],
                                    hole_device,
                                    tile=
                                        HOLE_TILE,
                                    stride=
                                        HOLE_STRIDE,
                                )
                            )

                            latest_hole_pred[
                                camera
                            ] = pred


                            # ====================================
                            # BEFORE SELECTION:
                            # detect all hole candidates.
                            # ====================================

                            if not target_selected[
                                camera
                            ]:

                                holes = (
                                    hole_live.extract_hole_centers(
                                        pred,
                                        HOLE_MIN_AREA,
                                        HOLE_MAX_AREA,
                                    )
                                )

                                latest_holes[
                                    camera
                                ] = holes


                            # ====================================
                            # AFTER SELECTION:
                            # do NOT associate with all holes.
                            #
                            # Search only in a local ROI around
                            # the previously selected target.
                            # ====================================

                            else:

                                # ====================================
                                # DYNAMIC_SELECTED_HOLE_TRACK_V1
                                #
                                # Tracking search center:
                                #   last RAW measured hole center
                                #
                                # Control target:
                                #   EMA-smoothed target_uv
                                #
                                # Do not use the smoothed control target as
                                # the next-frame search center.  On a moving
                                # wrist camera that creates large tracking lag.
                                # ====================================

                                tracking_previous_uv = (
                                    target_uv[
                                        camera
                                    ]
                                )

                                previous_selected_holes = (
                                    latest_holes.get(
                                        camera,
                                        [],
                                    )
                                )

                                if previous_selected_holes:

                                    previous_raw_center = (
                                        previous_selected_holes[
                                            0
                                        ].get(
                                            "center_uv"
                                        )
                                    )

                                    if previous_raw_center is not None:

                                        tracking_previous_uv = (
                                            float(
                                                previous_raw_center[0]
                                            ),
                                            float(
                                                previous_raw_center[1]
                                            ),
                                        )

                                tracked = (
                                    track_selected_hole(
                                        pred,
                                        tracking_previous_uv,
                                        camera,
                                    )
                                )


                                if tracked is not None:

                                    c = tracked[
                                        "center_uv"
                                    ]

                                    # ====================================
                                    # INSERTION_VISUAL_STABILITY_V1
                                    # Smooth the center of the already
                                    # identity-locked physical hole.
                                    # ====================================

                                    raw_hole_uv = (
                                        float(
                                            c[0]
                                        ),
                                        float(
                                            c[1]
                                        ),
                                    )

                                    previous_hole_uv = (
                                        target_uv[
                                            camera
                                        ]
                                    )

                                    if previous_hole_uv is None:

                                        filtered_hole_uv = (
                                            raw_hole_uv
                                        )

                                    else:

                                        a = float(
                                            HOLE_TRACK_EMA_ALPHA_BY_CAMERA.get(
                                                camera,
                                                HOLE_TRACK_EMA_ALPHA,
                                            )
                                        )

                                        filtered_hole_uv = (
                                            (
                                                1.0 - a
                                            )
                                            *
                                            float(
                                                previous_hole_uv[0]
                                            )
                                            +
                                            a
                                            *
                                            raw_hole_uv[0],
                                            (
                                                1.0 - a
                                            )
                                            *
                                            float(
                                                previous_hole_uv[1]
                                            )
                                            +
                                            a
                                            *
                                            raw_hole_uv[1],
                                        )

                                    target_uv[
                                        camera
                                    ] = (
                                        filtered_hole_uv
                                    )

                                    target_valid[
                                        camera
                                    ] = True

                                    target_update_time[
                                        camera
                                    ] = now

                                    # INSERTION_MEASUREMENT_FRESHNESS_V1
                                    insertion_hole_measurement_time[
                                        camera
                                    ] = time.time()


                                    # Keep ONLY the selected target.
                                    latest_holes[
                                        camera
                                    ] = [
                                        tracked
                                    ]


                                else:

                                    # Short segmentation dropout:
                                    # keep the manually selected
                                    # target instead of immediately
                                    # declaring TARGET LOST.
                                    age = (
                                        now
                                        -
                                        target_update_time[
                                            camera
                                        ]
                                    )


                                    if (
                                        0.0
                                        <=
                                        age
                                        <=
                                        HOLE_TARGET_HOLD_S
                                    ):

                                        target_valid[
                                            camera
                                        ] = True

                                    else:

                                        target_valid[
                                            camera
                                        ] = False


                                    # Other holes are intentionally
                                    # discarded after selection.
                                    latest_holes[
                                        camera
                                    ] = []


                        except Exception as exc:

                            print(
                                f"[HOLE ERROR] {camera}: {exc}",
                                flush=True,
                            )


                            if not target_selected[
                                camera
                            ]:

                                latest_holes[
                                    camera
                                ] = []


                            else:

                                age = (
                                    now
                                    -
                                    target_update_time[
                                        camera
                                    ]
                                )

                                target_valid[
                                    camera
                                ] = bool(
                                    0.0
                                    <=
                                    age
                                    <=
                                    HOLE_TARGET_HOLD_S
                                )

                                latest_holes[
                                    camera
                                ] = []


                # --------------------------------------------
                # FREE / TIP relationship
                # --------------------------------------------

                for camera in CAMERA_ORDER:

                    measured = (
                        measured_free_uv(
                            geometries[
                                camera
                            ]
                        )
                    )


                    # ============================================
                    # INSERTION_VISUAL_STABILITY_V1
                    # FREE endpoint:
                    #   raw measurement
                    #      -> jump rejection
                    #      -> EMA
                    #      -> control / TIP-relative history
                    # ============================================

                    if measured is not None:

                        # INSERTION_MEASUREMENT_FRESHNESS_V1
                        insertion_free_measurement_time[
                            camera
                        ] = time.time()

                        raw_free = (
                            float(
                                measured[0]
                            ),
                            float(
                                measured[1]
                            ),
                        )

                        previous_free = (
                            free_filtered_uv[
                                camera
                            ]
                        )

                        if previous_free is not None:

                            free_jump_px = (
                                point_distance(
                                    raw_free,
                                    previous_free,
                                )
                            )

                            if (
                                free_jump_px
                                >
                                FREE_TRACK_MAX_JUMP_PX
                            ):

                                # Reject one-frame geometry jump.
                                # Existing DISPLAY_ONLY /
                                # TIP_RELATIVE_PRED fallback below
                                # handles this frame.
                                measured = None

                            else:

                                a = (
                                    FREE_TRACK_EMA_ALPHA
                                )

                                filtered_free = (
                                    (
                                        1.0 - a
                                    )
                                    *
                                    float(
                                        previous_free[0]
                                    )
                                    +
                                    a
                                    *
                                    raw_free[0],
                                    (
                                        1.0 - a
                                    )
                                    *
                                    float(
                                        previous_free[1]
                                    )
                                    +
                                    a
                                    *
                                    raw_free[1],
                                )

                                free_filtered_uv[
                                    camera
                                ] = (
                                    filtered_free
                                )

                                measured = (
                                    filtered_free
                                )

                        else:

                            free_filtered_uv[
                                camera
                            ] = raw_free

                            measured = raw_free

                    display_free = (
                        display_free_uv(
                            geometries[
                                camera
                            ]
                        )
                    )

                    tip_uv = (
                        tip_uv_from_result(
                            tip_results[
                                camera
                            ],
                            geometries[
                                camera
                            ],
                        )
                    )


                    if (
                        measured
                        is not None
                        and
                        tip_uv
                        is not None
                    ):

                        rel = (
                            np.asarray(
                                measured,
                                dtype=np.float64,
                            )
                            -
                            np.asarray(
                                tip_uv,
                                dtype=np.float64,
                            )
                        )

                        tip_free_samples[
                            camera
                        ].append(
                            rel
                        )

                        last_measured_free_time[
                            camera
                        ] = now


                    if measured is not None:

                        free_uv = (
                            measured
                        )

                        free_source = (
                            "MEASURED"
                        )

                    elif display_free is not None:

                        # Display/temporal-hold FREE is useful
                        # for visualization and debugging,
                        # but insertion_guidance() explicitly
                        # refuses to use it for robot motion.
                        free_uv = (
                            display_free
                        )

                        free_source = (
                            "DISPLAY_ONLY"
                        )

                    else:

                        free_uv = None

                        free_source = None


                        samples = (
                            tip_free_samples[
                                camera
                            ]
                        )

                        age = (
                            now
                            -
                            last_measured_free_time[
                                camera
                            ]
                        )


                        if (
                            tip_uv
                            is not None
                            and
                            len(
                                samples
                            )
                            >=
                            3
                            and
                            0.0
                            <=
                            age
                            <=
                            TIP_FREE_FALLBACK_MAX_AGE_S
                        ):

                            ref = (
                                np.median(
                                    np.stack(
                                        list(
                                            samples
                                        ),
                                        axis=0,
                                    ),
                                    axis=0,
                                )
                            )

                            predicted = (
                                np.asarray(
                                    tip_uv,
                                    dtype=np.float64,
                                )
                                +
                                ref
                            )

                            free_uv = (
                                float(
                                    predicted[
                                        0
                                    ]
                                ),
                                float(
                                    predicted[
                                        1
                                    ]
                                ),
                            )

                            free_source = (
                                "TIP_RELATIVE_PRED"
                            )


                    # ============================================
                    # DISPLAY_ONLY_TO_TIP_PRED_V1
                    #
                    # A temporally-held DISPLAY_ONLY position must
                    # never directly command robot motion.
                    #
                    # However, DISPLAY_ONLY previously prevented the
                    # already implemented TIP-relative fallback from
                    # being reached at all.
                    #
                    # Therefore, when the measured FREE endpoint is
                    # temporarily unavailable, promote DISPLAY_ONLY
                    # to TIP_RELATIVE_PRED if a recent calibrated
                    # FREE<->TIP relation is available.
                    # ============================================

                    if (
                        free_source
                        ==
                        "DISPLAY_ONLY"
                    ):

                        samples = (
                            tip_free_samples[
                                camera
                            ]
                        )

                        age = (
                            now
                            -
                            last_measured_free_time[
                                camera
                            ]
                        )

                        if (
                            tip_uv
                            is not None
                            and
                            len(samples)
                            >=
                            3
                            and
                            0.0
                            <=
                            age
                            <=
                            TIP_FREE_FALLBACK_MAX_AGE_S
                        ):

                            ref = (
                                np.median(
                                    np.stack(
                                        list(
                                            samples
                                        ),
                                        axis=0,
                                    ),
                                    axis=0,
                                )
                            )

                            predicted = (
                                np.asarray(
                                    tip_uv,
                                    dtype=np.float64,
                                )
                                +
                                ref
                            )

                            free_uv = (
                                float(
                                    predicted[0]
                                ),
                                float(
                                    predicted[1]
                                ),
                            )

                            free_source = (
                                "TIP_RELATIVE_PRED"
                            )


                    # ============================================
                    # FREE_CONTROL_HOLD_APPLY_V1
                    #
                    # Avoid source flapping:
                    #
                    # MEASURED / TIP_RELATIVE_PRED
                    #     -> refresh last real control point
                    #
                    # short DISPLAY_ONLY / missing interval
                    #     -> reuse last control FREE <= 0.25 s
                    #
                    # longer loss
                    #     -> existing invalid / STOP behavior
                    # ============================================

                    if (
                        free_uv is not None
                        and
                        free_source
                        in (
                            "MEASURED",
                            "TIP_RELATIVE_PRED",
                        )
                    ):

                        last_control_free_uv[
                            camera
                        ] = (
                            float(
                                free_uv[0]
                            ),
                            float(
                                free_uv[1]
                            ),
                        )

                        last_control_free_time[
                            camera
                        ] = now

                    elif (
                        free_source
                        in (
                            "DISPLAY_ONLY",
                            None,
                        )
                    ):

                        control_age = (
                            now
                            -
                            last_control_free_time[
                                camera
                            ]
                        )

                        previous_control_free = (
                            last_control_free_uv[
                                camera
                            ]
                        )

                        if (
                            previous_control_free
                            is not None
                            and
                            0.0
                            <=
                            control_age
                            <=
                            FREE_CONTROL_HOLD_S
                        ):

                            free_uv = (
                                previous_control_free
                            )

                            free_source = (
                                "MEASURED_HOLD"
                            )


                    latest_free_guidance[
                        camera
                    ] = {
                        "uv":
                            free_uv,

                        "source":
                            free_source,

                        "tip_uv":
                            tip_uv,
                    }


                # --------------------------------------------
                # Target freshness
                # --------------------------------------------

                for camera in CAMERA_ORDER:

                    if target_valid[
                        camera
                    ]:

                        age = (
                            now
                            -
                            target_update_time[
                                camera
                            ]
                        )

                        if (
                            age
                            >
                            HOLE_FRESH_S
                        ):

                            target_valid[
                                camera
                            ] = False


                # --------------------------------------------
                # WAIT_HOLE_TARGET:
                # Never output motion.
                # --------------------------------------------

                if phase == PHASE_WAIT_HOLE:

                    latest_external_guidance = (
                        invalid_guidance(
                            "external",
                            phase,
                            "WAITING_FOR_THREE_HOLE_TARGETS_AND_ENTER",
                        )
                    )

                    latest_wrist_guidance = (
                        invalid_guidance(
                            "left_wrist",
                            phase,
                            "WAITING_FOR_THREE_HOLE_TARGETS_AND_ENTER",
                        )
                    )


                # --------------------------------------------
                # INSERTION:
                # FREE -> selected HOLE
                # --------------------------------------------

                elif phase == PHASE_INSERTION:

                    ext_free = (
                        latest_free_guidance[
                            "external"
                        ]
                    )

                    left_free = (
                        latest_free_guidance[
                            "left_wrist"
                        ]
                    )


                    latest_external_guidance = (
                        insertion_guidance(
                            "external",
                            ext_free[
                                "uv"
                            ],
                            ext_free[
                                "source"
                            ],
                            target_uv[
                                "external"
                            ],
                            ext_free[
                                "tip_uv"
                            ],
                            target_valid[
                                "external"
                            ],
                            measurement_timestamp=
                                insertion_measurement_timestamp(
                                    insertion_free_measurement_time[
                                        "external"
                                    ],
                                    insertion_hole_measurement_time[
                                        "external"
                                    ],
                                ),
                            source_frame_seq=
                                frame_counter,
                        )
                    )


                    latest_wrist_guidance = (
                        insertion_guidance(
                            "left_wrist",
                            left_free[
                                "uv"
                            ],
                            left_free[
                                "source"
                            ],
                            target_uv[
                                "left_wrist"
                            ],
                            left_free[
                                "tip_uv"
                            ],
                            target_valid[
                                "left_wrist"
                            ],
                            measurement_timestamp=
                                insertion_measurement_timestamp(
                                    insertion_free_measurement_time[
                                        "left_wrist"
                                    ],
                                    insertion_hole_measurement_time[
                                        "left_wrist"
                                    ],
                                ),
                            source_frame_seq=
                                frame_counter,
                        )
                    )


                # ====================================================
                # INSERTION_DATASET_RECORDER_INTEGRATION_V1
                #
                # Record existing camera frames + perception state.
                #
                # IMPORTANT:
                #   - no camera is reopened here
                #   - no robot command is published here
                #   - writer thread only performs disk I/O
                # ====================================================

                recorder_selected_control = [
                    camera
                    for camera
                    in INSERTION_CONTROL_CAMERAS
                    if (
                        target_selected[
                            camera
                        ]
                        and
                        target_uv[
                            camera
                        ]
                        is not None
                    )
                ]

                recorder_valid_control = [
                    camera
                    for camera
                    in recorder_selected_control
                    if target_valid[
                        camera
                    ]
                ]

                dataset_recorder.record(
                    frame_counter=
                        frame_counter,

                    phase=
                        phase,

                    frames=
                        frames,

                    free_guidance=
                        latest_free_guidance,

                    target_uv=
                        target_uv,

                    target_selected=
                        target_selected,

                    target_valid=
                        target_valid,

                    external_guidance=
                        latest_external_guidance,

                    wrist_guidance=
                        latest_wrist_guidance,

                    extra={
                        "target_confirmed":
                            bool(
                                target_confirmed
                            ),

                        "selected_control_cameras":
                            list(
                                recorder_selected_control
                            ),

                        "valid_control_cameras":
                            list(
                                recorder_valid_control
                            ),

                        "control_target_count":
                            int(
                                len(
                                    recorder_valid_control
                                )
                            ),

                        "degraded_single_view":
                            bool(
                                len(
                                    recorder_valid_control
                                )
                                ==
                                1
                            ),
                    },
                )


                # --------------------------------------------
                # Handshake for Gate
                # --------------------------------------------

                all_selected = all(
                    target_selected.values()
                )

                all_target_valid = all(
                    target_valid.values()
                )

                # OPTIONAL_CONTROL_CAMERA_HOLE_SELECTION_V1
                #
                # Keep all_selected / all_target_valid only as
                # diagnostics.  They are no longer hard gates.
                #
                # Runtime insertion authority comes only from
                # External / Left Wrist.

                selected_control_cameras = [
                    camera
                    for camera
                    in INSERTION_CONTROL_CAMERAS
                    if (
                        target_selected[
                            camera
                        ]
                        and
                        target_uv[
                            camera
                        ]
                        is not None
                    )
                ]

                valid_control_cameras = [
                    camera
                    for camera
                    in selected_control_cameras
                    if target_valid[
                        camera
                    ]
                ]

                control_target_count = (
                    len(
                        valid_control_cameras
                    )
                )

                degraded_single_view = bool(
                    control_target_count
                    ==
                    1
                )

                target_ready = bool(
                    phase
                    ==
                    PHASE_INSERTION
                    and
                    target_confirmed
                    and
                    control_target_count
                    ==
                    len(
                        INSERTION_CONTROL_CAMERAS
                    )
                )


                atomic_json(
                    TARGET_STATE_OUT,
                    {
                        "timestamp":
                            now,

                        "phase":
                            phase,

                        "target_ready":
                            target_ready,

                        "target_confirmed":
                            bool(
                                target_confirmed
                            ),

                        "all_selected":
                            bool(
                                all_selected
                            ),

                        "all_target_valid":
                            bool(
                                all_target_valid
                            ),

                        # OPTIONAL_CONTROL_CAMERA_HOLE_SELECTION_V1
                        "selected_control_cameras":
                            list(
                                selected_control_cameras
                            ),

                        "valid_control_cameras":
                            list(
                                valid_control_cameras
                            ),

                        "control_target_count":
                            int(
                                control_target_count
                            ),

                        "degraded_single_view":
                            bool(
                                degraded_single_view
                            ),

                        "selected": {
                            camera:
                                bool(
                                    target_selected[
                                        camera
                                    ]
                                )
                            for camera
                            in CAMERA_ORDER
                        },

                        "valid": {
                            camera:
                                bool(
                                    target_valid[
                                        camera
                                    ]
                                )
                            for camera
                            in CAMERA_ORDER
                        },

                        "target_uv": {
                            camera:
                                (
                                    list(
                                        target_uv[
                                            camera
                                        ]
                                    )
                                    if
                                    target_uv[
                                        camera
                                    ]
                                    is not None
                                    else
                                    None
                                )
                            for camera
                            in CAMERA_ORDER
                        },
                    },
                )


                atomic_json(
                    PERCEPTION_STATE_OUT,
                    {
                        "timestamp":
                            now,

                        "phase":
                            phase,

                        "target_ready":
                            target_ready,

                        "cameras": {
                            camera: {
                                "free_uv":
                                    (
                                        list(
                                            latest_free_guidance[
                                                camera
                                            ][
                                                "uv"
                                            ]
                                        )
                                        if
                                        latest_free_guidance[
                                            camera
                                        ][
                                            "uv"
                                        ]
                                        is not None
                                        else
                                        None
                                    ),

                                "free_source":
                                    latest_free_guidance[
                                        camera
                                    ][
                                        "source"
                                    ],

                                "tip_uv":
                                    (
                                        list(
                                            latest_free_guidance[
                                                camera
                                            ][
                                                "tip_uv"
                                            ]
                                        )
                                        if
                                        latest_free_guidance[
                                            camera
                                        ][
                                            "tip_uv"
                                        ]
                                        is not None
                                        else
                                        None
                                    ),

                                "hole_uv":
                                    (
                                        list(
                                            target_uv[
                                                camera
                                            ]
                                        )
                                        if
                                        target_uv[
                                            camera
                                        ]
                                        is not None
                                        else
                                        None
                                    ),

                                "hole_valid":
                                    bool(
                                        target_valid[
                                            camera
                                        ]
                                    ),
                            }
                            for camera
                            in CAMERA_ORDER
                        },
                    },
                )


            # =================================================
            # Display
            # =================================================

            visuals = {}


            for camera in CAMERA_ORDER:

                vis = (
                    grasp.draw_scene(
                        frames[
                            camera
                        ],
                        detections[
                            camera
                        ],
                        tracks[
                            camera
                        ],
                        geometries[
                            camera
                        ],
                        camera.upper(),
                        fps_values[
                            camera
                        ],
                    )
                )


                vis = (
                    grasp.draw_tip(
                        vis,
                        tip_results[
                            camera
                        ],
                    )
                )


                if phase == PHASE_GRASP:

                    if camera == "external":

                        vis = (
                            grasp.draw_guidance(
                                vis,
                                latest_external_guidance,
                                "external",
                            )
                        )

                    elif camera == "right_wrist":

                        vis = (
                            grasp.draw_guidance(
                                vis,
                                latest_wrist_guidance,
                                "right_wrist",
                            )
                        )

                    else:

                        cv2.putText(
                            vis,
                            "LEFT WRIST: GRASP MONITOR",
                            (
                                12,
                                178,
                            ),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.46,
                            (
                                255,
                                255,
                                255,
                            ),
                            1,
                            cv2.LINE_AA,
                        )


                else:

                    vis = (
                        draw_hole_overlay(
                            vis,
                            latest_hole_pred[
                                camera
                            ],
                            latest_holes[
                                camera
                            ],
                            target_uv[
                                camera
                            ],
                            target_valid[
                                camera
                            ],
                        )
                    )


                    f = (
                        latest_free_guidance[
                            camera
                        ]
                    )

                    vis = (
                        draw_insertion_free(
                            vis,
                            f[
                                "uv"
                            ],
                            f[
                                "source"
                            ],
                            (
                                target_uv[
                                    camera
                                ]
                                if
                                target_selected[
                                    camera
                                ]
                                else
                                None
                            ),
                        )
                    )


                    if phase == PHASE_WAIT_HOLE:

                        cv2.putText(
                            vis,
                            (
                                "CLICK TARGET HOLE"
                                if
                                not target_selected[
                                    camera
                                ]
                                else
                                "TARGET SELECTED"
                            ),
                            (
                                12,
                                178,
                            ),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.52,
                            (
                                0,
                                255,
                                255,
                            ),
                            2,
                            cv2.LINE_AA,
                        )


                    elif phase == PHASE_INSERTION:

                        cv2.putText(
                            vis,
                            (
                                "INSERTION: FREE -> HOLE"
                            ),
                            (
                                12,
                                178,
                            ),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.50,
                            (
                                0,
                                255,
                                255,
                            ),
                            2,
                            cv2.LINE_AA,
                        )


                vis = (
                    draw_phase(
                        vis,
                        phase,
                    )
                )


                visuals[
                    camera
                ] = vis


            resized = {
                camera:
                    grasp.base.resize_panel(
                        visuals[
                            camera
                        ]
                    )
                for camera
                in CAMERA_ORDER
            }


            panel_layout.clear()

            x0 = 0

            for camera in CAMERA_ORDER:

                h, w = (
                    resized[
                        camera
                    ].shape[:2]
                )

                panel_layout[
                    camera
                ] = {
                    "x0":
                        x0,

                    "x1":
                        x0 + w,

                    "w":
                        w,

                    "h":
                        h,
                }

                x0 += w


            panel = np.hstack(
                [
                    resized[
                        camera
                    ]
                    for camera
                    in CAMERA_ORDER
                ]
            )


            cv2.imshow(
                WINDOW,
                panel,
            )


            # ------------------------------------------------
            # Console status
            # ------------------------------------------------

            now_mono = (
                time.monotonic()
            )

            if (
                now_mono
                -
                last_print
                >
                1.0
            ):

                if phase == PHASE_GRASP:

                    print(
                        "[GRASP] "
                        f"EXT valid={latest_external_guidance.get('guidance_valid')} "
                        f"WRIST valid={latest_wrist_guidance.get('guidance_valid')}",
                        flush=True,
                    )

                else:

                    print(
                        f"[{phase}] "
                        f"target="
                        f"E:{int(target_selected['external'])}/"
                        f"{int(target_valid['external'])} "
                        f"R:{int(target_selected['right_wrist'])}/"
                        f"{int(target_valid['right_wrist'])} "
                        f"L:{int(target_selected['left_wrist'])}/"
                        f"{int(target_valid['left_wrist'])} | "
                        f"FREE "
                        f"E={latest_free_guidance['external']['source']} "
                        f"R={latest_free_guidance['right_wrist']['source']} "
                        f"L={latest_free_guidance['left_wrist']['source']}",
                        flush=True,
                    )

                last_print = (
                    now_mono
                )


            # ------------------------------------------------
            # Keyboard
            # ------------------------------------------------

            key = (
                cv2.waitKey(1)
                &
                0xFF
            )


            # ENTER
            if key in (
                10,
                13,
                32,
                ord("e"),
                ord("E"),
            ):

                if phase == PHASE_WAIT_HOLE:

                    # OPTIONAL_CONTROL_CAMERA_HOLE_SELECTION_V1
                    control_ready_cameras = [
                        camera
                        for camera
                        in INSERTION_CONTROL_CAMERAS
                        if (
                            target_selected[
                                camera
                            ]
                            and
                            target_uv[
                                camera
                            ]
                            is not None
                            and
                            target_valid[
                                camera
                            ]
                        )
                    ]

                    if len(control_ready_cameras) == len(INSERTION_CONTROL_CAMERAS):

                        target_confirmed = True

                        phase = (
                            PHASE_INSERTION
                        )

                        print()
                        print(
                            "=" * 90
                        )

                        print(
                            "[PHASE] WAIT_HOLE_TARGET -> INSERTION_TRACKING"
                        )

                        print(
                            "[PHASE] target confirmed by control camera(s): "
                            +
                            ",".join(
                                control_ready_cameras
                            )
                        )

                        print(
                            "[PHASE] External + Left Wrist FREE->HOLE guidance ENABLED"
                        )

                        print(
                            "=" * 90
                        )
                        print()

                    else:

                        print(
                            "[HOLE CONFIRM] rejected: "
                            "select valid targets in BOTH External and Left Wrist"
                        )


            # R = stop insertion and select again.
            elif key in (
                ord("r"),
                ord("R"),
            ):

                if phase != PHASE_GRASP:

                    phase = (
                        PHASE_WAIT_HOLE
                    )

                    target_confirmed = False

                    for camera in CAMERA_ORDER:

                        target_selected[
                            camera
                        ] = False

                        target_valid[
                            camera
                        ] = False

                        target_uv[
                            camera
                        ] = None

                        target_update_time[
                            camera
                        ] = 0.0

                        insertion_hole_measurement_time[
                            camera
                        ] = 0.0

                        insertion_free_measurement_time[
                            camera
                        ] = 0.0


                    invalid_guidance(
                        "external",
                        phase,
                        "TARGET_RESELECT",
                    )

                    invalid_guidance(
                        "left_wrist",
                        phase,
                        "TARGET_RESELECT",
                    )

                    print(
                        "[HOLE] targets cleared; motion guidance STOPPED"
                    )


            # P = diagnostic print
            elif key in (
                ord("p"),
                ord("P"),
            ):

                print()
                print(
                    "[INSERTION STATE]"
                )

                print(
                    json.dumps(
                        read_json(
                            PERCEPTION_STATE_OUT
                        ),
                        indent=2,
                    )
                )

                print()


            # Existing clear calibration only before grasp.
            elif key in (
                ord("c"),
                ord("C"),
            ):

                if phase == PHASE_GRASP:

                    for tracker in (
                        free_trackers.values()
                    ):

                        tracker.clear()


                    for tracker in (
                        tip_trackers.values()
                    ):

                        tracker.clear()


                    temporal_trackers = {
                        camera:
                            grasp.temporal.TemporalTracker(
                                camera
                            )
                        for camera
                        in CAMERA_ORDER
                    }


                    for camera in FIXED_WIRE_CAMERAS:

                        locked[
                            camera
                        ] = False

                        locked_tracks[
                            camera
                        ] = None

                        locked_geometry[
                            camera
                        ] = None


                    print(
                        "[CLEAR] all GRASP calibration cleared"
                    )


            elif key in (
                ord("q"),
                ord("Q"),
                27,
            ):

                break


    except KeyboardInterrupt:

        print(
            "\n[INFO] Ctrl+C"
        )


    finally:

        invalid_guidance(
            "external",
            "EXIT",
            "VISUAL_PROGRAM_EXIT",
        )

        invalid_guidance(
            "left_wrist",
            "EXIT",
            "VISUAL_PROGRAM_EXIT",
        )


        atomic_json(
            TARGET_STATE_OUT,
            {
                "timestamp":
                    time.time(),

                "phase":
                    "EXIT",

                "target_ready":
                    False,

                "target_confirmed":
                    False,
            },
        )


        if external is not None:

            try:
                external.release()
            except Exception:
                pass


        if right is not None:

            try:
                right.stop()
            except Exception:
                pass


        if left is not None:

            try:
                left.stop()
            except Exception:
                pass


        cv2.destroyAllWindows()

        print(
            "[INFO] Grasp -> Insertion Visual V1 stopped"
        )


if __name__ == "__main__":
    main()
