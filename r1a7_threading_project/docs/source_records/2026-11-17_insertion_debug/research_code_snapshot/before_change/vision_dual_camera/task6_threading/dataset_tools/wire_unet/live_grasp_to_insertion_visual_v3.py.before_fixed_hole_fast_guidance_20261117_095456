def insertion_guidance(
    camera,
    free_uv,
    free_source,
    hole_uv,
    tip_uv,
    target_valid,
    measurement_timestamp=None,
    source_frame_seq=None,
):

    now = time.time()
    publish_monotonic_s = time.monotonic()

    try:
        measurement_timestamp_value = (
            float(measurement_timestamp)
            if measurement_timestamp is not None
            else None
        )
    except Exception:
        measurement_timestamp_value = None

    if (
        measurement_timestamp_value is not None
        and
        measurement_timestamp_value > 0.0
    ):
        measurement_age_ms_at_publish = max(
            0.0,
            (
                now
                -
                measurement_timestamp_value
            )
            *
            1000.0,
        )
    else:
        measurement_age_ms_at_publish = None

    control_free_valid = bool(
        free_source
        in (
            "MEASURED",
            "MEASURED_HOLD",
            "TIP_RELATIVE_PRED",
        )
    )

    valid = bool(
        free_uv
        is not None
        and
        hole_uv
        is not None
        and
        target_valid
        and
        control_free_valid
    )

    if valid:

        du = float(
            hole_uv[0]
            -
            free_uv[0]
        )

        dv = float(
            hole_uv[1]
            -
            free_uv[1]
        )

        norm = float(
            math.hypot(
                du,
                dv,
            )
        )

        if (
            free_source
            ==
            "TIP_RELATIVE_PRED"
        ):
            speed_scale = (
                TIP_FREE_FALLBACK_SPEED_SCALE
            )

        elif (
            free_source
            ==
            "MEASURED_HOLD"
        ):
            speed_scale = (
                FREE_CONTROL_HOLD_SPEED_SCALE
            )

        else:
            speed_scale = 1.0

        if camera == "external":

            vx = (
                grasp.axis_command(
                    du,
                    grasp.KP_EXT_X,
                    +1.0,
                )
                *
                speed_scale
            )

            vy = 0.0

            vz = (
                grasp.axis_command(
                    dv,
                    grasp.KP_EXT_Z,
                    -1.0,
                )
                *
                speed_scale
            )

        elif camera == "left_wrist":

            # INSERTION_LEFT_WRIST_2X2_SHADOW_V1
            #
            # Left Wrist camera has significant Y/Z image
            # cross-coupling.  Do NOT use the old independent:
            #
            #   du -> Y
            #   dv -> Z
            #
            # controller from Right Wrist.
            #
            # Instead:
            #
            #   [vy, vz]^T
            #       =
            #   -K * inv(J_yz) * [du, dv]^T

            vx = 0.0

            if (
                abs(du)
                <=
                grasp.DEADBAND_PX
                and
                abs(dv)
                <=
                grasp.DEADBAND_PX
            ):

                vy = 0.0
                vz = 0.0

            else:

                error_uv = np.asarray(
                    [
                        du,
                        dv,
                    ],
                    dtype=np.float64,
                )

                yz_velocity = (
                    -
                    LEFT_INSERTION_K_S
                    *
                    (
                        LEFT_INSERTION_INV_J_YZ
                        @
                        error_uv
                    )
                )

                yz_velocity *= float(
                    speed_scale
                )

                vy = float(
                    np.clip(
                        yz_velocity[0],
                        -LEFT_INSERTION_MAX_AXIS_MM_S,
                        +LEFT_INSERTION_MAX_AXIS_MM_S,
                    )
                )

                vz = float(
                    np.clip(
                        yz_velocity[1],
                        -LEFT_INSERTION_MAX_AXIS_MM_S,
                        +LEFT_INSERTION_MAX_AXIS_MM_S,
                    )
                )

        else:

            vx = 0.0
            vy = 0.0
            vz = 0.0

    else:

        du = None
        dv = None
        norm = None

        vx = 0.0
        vy = 0.0
        vz = 0.0


    out = {
        "timestamp":
            now,

        # INSERTION_MEASUREMENT_FRESHNESS_V1
        "guidance_publish_timestamp":
            now,

        "guidance_publish_monotonic_s":
            float(
                publish_monotonic_s
            ),

        "measurement_timestamp":
            measurement_timestamp_value,

        "measurement_age_ms_at_publish":
            measurement_age_ms_at_publish,

        "source_frame_seq":
            (
                int(source_frame_seq)
                if source_frame_seq is not None
                else None
            ),

        "enabled":
            False,

        "shadow_mode":
            True,

        "phase":
            PHASE_INSERTION,

        "source":
            (
                "grasp_to_insertion_v1_"
                +
                camera
            ),

        "guidance_valid":
            valid,

        "wire_locked":
            False,

        "free_target_uv":
            (
                list(
                    free_uv
                )
                if
                free_uv
                is not None
                else
                None
            ),

        "target_hole_uv":
            (
                list(
                    hole_uv
                )
                if
                hole_uv
                is not None
                else
                None
            ),

        "tweezer_tip_uv":
            (
                list(
                    tip_uv
                )
                if
                tip_uv
                is not None
                else
                None
            ),

        "free_source":
            free_source,

        "control_camera":
            str(
                camera
            ),

        "left_wrist_mapping_version":
            (
                "LEFT_WRIST_2X2_SHADOW_V1"
                if camera == "left_wrist"
                else None
            ),

        "left_wrist_mapping_r2_du":
            (
                LEFT_INSERTION_MAPPING_R2_DU
                if camera == "left_wrist"
                else None
            ),

        "left_wrist_mapping_r2_dv":
            (
                LEFT_INSERTION_MAPPING_R2_DV
                if camera == "left_wrist"
                else None
            ),


        "du_px":
            du,

        "dv_px":
            dv,

        "error_norm_px":
            norm,

        # Preserve fields expected by the current auto-grasp reader.
        "tip_grasp_distance_px":
            None,

        "tool_pixels":
            0,

        "front_pixels":
            0,

        "axis_ratio":
            None,

        "tip_status":
            (
                "INSERTION_FREE_TO_HOLE"
                if valid
                else
                "INSERTION_INVALID"
            ),

        # Direct IBVS velocity aliases.
        "vx_mm_s":
            float(
                vx
            ),

        "vy_mm_s":
            float(
                vy
            ),

        "vz_mm_s":
            float(
                vz
            ),

        "proposed_vx_mm_s":
            float(
                vx
            ),

        "proposed_vy_mm_s":
            float(
                vy
            ),

        "proposed_vz_mm_s":
            float(
                vz
            ),
    }


    if camera == "external":

        atomic_json(
            grasp.EXTERNAL_OUT,
            out,
        )

    elif camera in (
        "right_wrist",
        "left_wrist",
    ):

        atomic_json(
            grasp.WRIST_OUT,
            out,
        )

    return out


