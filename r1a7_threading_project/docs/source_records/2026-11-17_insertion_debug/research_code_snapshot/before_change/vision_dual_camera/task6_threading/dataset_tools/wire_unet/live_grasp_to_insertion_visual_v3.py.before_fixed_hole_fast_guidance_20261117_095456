def yx_to_uv(point):

    if point is None:
        return None

    try:

        a = np.asarray(
            point,
            dtype=np.float64,
        ).reshape(-1)

        if a.size < 2:
            return None

        return (
            float(a[1]),
            float(a[0]),
        )

    except Exception:

        return None


def xy_to_uv(point):

