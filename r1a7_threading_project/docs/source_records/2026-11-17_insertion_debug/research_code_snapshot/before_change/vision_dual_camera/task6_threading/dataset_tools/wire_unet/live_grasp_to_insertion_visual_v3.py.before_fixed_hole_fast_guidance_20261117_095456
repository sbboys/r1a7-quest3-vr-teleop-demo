def draw_hole_overlay(
    image,
    pred,
    holes,
    selected,
    selected_valid,
):

    out = image.copy()


    # --------------------------------------------------------
    # BEFORE target selection:
    # show candidate holes for mouse selection.
    # --------------------------------------------------------

    if selected is None:

        for hole in holes:

            center = hole.get(
                "center_uv"
            )

            if center is None:
                continue


            u = int(
                round(
                    center[0]
                )
            )

            v = int(
                round(
                    center[1]
                )
            )


            cv2.circle(
                out,
                (
                    u,
                    v,
                ),
                4,
                (
                    0,
                    0,
                    255,
                ),
                1,
            )


    # --------------------------------------------------------
    # AFTER target selection:
    # do NOT display any other hole.
    #
    # Selected hole = one small cross only.
    # --------------------------------------------------------

    else:

        u = int(
            round(
                selected[0]
            )
        )

        v = int(
            round(
                selected[1]
            )
        )


        color = (
            (
                255,
                0,
                255,
            )
            if
            selected_valid
            else
            (
                0,
                0,
                255,
            )
        )


        cv2.drawMarker(
            out,
            (
                u,
                v,
            ),
            color,
            cv2.MARKER_CROSS,
            11,
            1,
            cv2.LINE_AA,
        )


    return out


def draw_insertion_free(
    image,
    free_uv,
    free_source,
    hole_uv,
):

    out = image

    if free_uv is not None:

        u = int(
            round(
                free_uv[0]
            )
        )

        v = int(
            round(
                free_uv[1]
            )
        )

        if (
            free_source
            ==
            "TIP_RELATIVE_PRED"
        ):

            color = (
                255,
                255,
                0,
            )

            label = (
                "FREE-PRED"
            )

        elif (
            free_source
            ==
            "DISPLAY_ONLY"
        ):

            color = (
                0,
                255,
                255,
            )

            label = (
                "FREE-HOLD"
            )

        else:

            color = (
                0,
                255,
                0,
            )

            label = (
                "FREE-LIVE"
            )

        cv2.drawMarker(
            out,
            (
                u,
                v,
            ),
            color,
            cv2.MARKER_CROSS,
            24,
            2,
        )

        cv2.putText(
            out,
            label,
            (
                u + 12,
                v - 12,
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.44,
            color,
            1,
            cv2.LINE_AA,
        )


        if hole_uv is not None:

            hu = int(
                round(
                    hole_uv[0]
                )
            )

            hv = int(
                round(
                    hole_uv[1]
                )
            )

            cv2.line(
                out,
                (
                    u,
                    v,
                ),
                (
                    hu,
                    hv,
                ),
                (
                    255,
                    255,
                    255,
                ),
                2,
            )


    return out


def draw_phase(
