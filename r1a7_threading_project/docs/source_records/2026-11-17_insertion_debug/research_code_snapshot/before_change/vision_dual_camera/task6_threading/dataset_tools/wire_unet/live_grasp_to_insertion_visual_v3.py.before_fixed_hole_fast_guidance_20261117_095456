def tip_uv_from_result(
    tip_result,
    geometry,
):

    if not tip_result:
        return None

    if not bool(
        tip_result.get(
            "valid",
            False,
        )
    ):
        return None

    # First use the already validated grasp visual helper.
    try:

        err = grasp.calculate_error(
            tip_result,
            geometry,
        )

        if (
            err is not None
            and
            err.get(
                "tip_uv"
            )
            is not None
        ):
            return xy_to_uv(
                err[
                    "tip_uv"
                ]
            )

    except Exception:
        pass


    # Compatibility with possible tracker result schemas.
    for key in (
        "tip_uv",
        "tip_point_uv",
        "midpoint_uv",
        "center_uv",
    ):

        if (
            key
            in tip_result
            and
            tip_result[
                key
            ]
            is not None
        ):

            p = xy_to_uv(
                tip_result[
                    key
                ]
            )

            if p is not None:
                return p


    for key in (
        "tip_yx",
        "tip_point_yx",
        "midpoint_yx",
    ):

        if (
            key
            in tip_result
            and
            tip_result[
                key
            ]
            is not None
        ):

            p = yx_to_uv(
                tip_result[
                    key
                ]
            )

            if p is not None:
                return p


    return None


def point_distance(
    a,
    b,
):

    if (
        a is None
        or
        b is None
    ):
        return float(
            "inf"
        )

    return float(
        math.hypot(
            float(a[0])
            -
            float(b[0]),
            float(a[1])
            -
            float(b[1]),
        )
    )


# ============================================================
# Hole selection/tracking
# ============================================================

def nearest_hole(
    holes,
    uv,
):

    if (
        not holes
        or
        uv is None
    ):
        return (
            None,
            float("inf"),
        )

    best = None
    best_d = float(
        "inf"
    )

    for hole in holes:

        center = hole.get(
            "center_uv"
        )

        if center is None:
            continue

        d = point_distance(
            center,
            uv,
        )

        if d < best_d:

            best_d = d
            best = hole

    return (
        best,
        best_d,
    )


def track_selected_hole(
    pred,
    previous_uv,
    camera,
):

    if (
        pred is None
        or
        previous_uv is None
    ):
        return None


    h, w = pred.shape[:2]

    u = float(
        previous_uv[0]
    )

    v = float(
        previous_uv[1]
    )

    # DYNAMIC_SELECTED_HOLE_TRACK_V1
    r = int(
        HOLE_TRACK_ROI_RADIUS_BY_CAMERA.get(
            camera,
            HOLE_TARGET_ROI_RADIUS_PX,
        )
    )

    max_jump = float(
        HOLE_TRACK_MAX_JUMP_BY_CAMERA.get(
            camera,
            HOLE_TRACK_MAX_JUMP_PX,
        )
    )


    x0 = max(
        0,
        int(round(u)) - r,
    )

    x1 = min(
        w,
        int(round(u)) + r + 1,
    )

    y0 = max(
        0,
        int(round(v)) - r,
    )

    y1 = min(
        h,
        int(round(v)) + r + 1,
    )


    if (
        x1 <= x0
        or
        y1 <= y0
    ):
        return None


    # Only inspect the local neighborhood of the selected hole.
    local_pred = pred[
        y0:y1,
        x0:x1,
    ]


    local_holes = (
        hole_live.extract_hole_centers(
            local_pred,
            HOLE_MIN_AREA,
            HOLE_MAX_AREA,
        )
    )


    candidates = []

    for hole in local_holes:

        c = hole.get(
            "center_uv"
        )

        if c is None:
            continue


        global_center = (
            float(c[0]) + x0,
            float(c[1]) + y0,
        )


        candidates.append({
            "center_uv":
                global_center,

            "area":
                hole.get(
                    "area",
                    0,
                ),

            "bbox":
                hole.get(
                    "bbox",
                ),
        })


    best, distance = (
        nearest_hole(
            candidates,
            previous_uv,
        )
    )


    if (
        best is None
        or
        distance
        >
        max_jump
    ):
        return None


    return best


# ============================================================
# INSERTION_MEASUREMENT_FRESHNESS_V1
#
# Keep publish time separate from the newest real measurements
# used to build the velocity command.
# ============================================================

def insertion_measurement_timestamp(
    free_measurement_time,
    hole_measurement_time,
):
    try:
        ft = float(free_measurement_time)
        ht = float(hole_measurement_time)

        if ft <= 0.0 or ht <= 0.0:
            return None

        # A command is only as new as its oldest required
        # measurement.
        return min(ft, ht)

    except Exception:
        return None


