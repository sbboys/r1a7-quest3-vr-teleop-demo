#!/usr/bin/env python3

import json
import math
import os
import time
from pathlib import Path


EXT_FILE = Path(
    "/tmp/r1a7_external_wire_grasp_v1.json"
)

WRIST_FILE = Path(
    "/tmp/r1a7_wrist_wire_grasp_guidance.json"
)

OUTPUT = Path(
    "/tmp/r1a7_wire_grasp_fusion_shadow_v1.json"
)


MAX_AGE = 0.40

MAX_VECTOR_MM_S = 10.0


def read(path):

    try:
        return json.loads(
            path.read_text()
        )
    except Exception:
        return {}


def age(data, now):

    try:
        return max(
            0.0,
            now -
            float(
                data["timestamp"]
            )
        )
    except Exception:
        return float("inf")


def valid(data, a):

    return bool(
        data
        and
        a <= MAX_AGE
        and
        data.get(
            "guidance_valid",
            False
        )
    )


def vector_limit(
    x,
    y,
    z
):

    n = math.sqrt(
        x*x +
        y*y +
        z*z
    )

    if (
        n <= MAX_VECTOR_MM_S
        or
        n <= 1e-9
    ):
        return (
            x,
            y,
            z
        )

    k = (
        MAX_VECTOR_MM_S
        /
        n
    )

    return (
        x*k,
        y*k,
        z*k
    )


def atomic(data):

    tmp = Path(
        str(OUTPUT) + ".tmp"
    )

    tmp.write_text(
        json.dumps(
            data,
            indent=2
        )
    )

    os.replace(
        tmp,
        OUTPUT
    )


last_mode = None


# BLIND_GRACE_TREND_V1
#
# Trend-test purpose:
# bridge short visual dropouts with the most recent valid
# Cartesian direction instead of immediately outputting STOP.
#
# Real sustained visual loss still causes STOP.
BLIND_GRACE_TIME_S = 0.40
BLIND_GRACE_SCALE = 0.40
BLIND_GRACE_MAX_SPEED_MM_S = 2.0

last_valid_time = None
last_valid_velocity = (
    0.0,
    0.0,
    0.0,
)


while True:

    now = time.time()

    ext = read(
        EXT_FILE
    )

    wrist = read(
        WRIST_FILE
    )

    ea = age(
        ext,
        now
    )

    wa = age(
        wrist,
        now
    )

    ev = valid(
        ext,
        ea
    )

    wv = valid(
        wrist,
        wa
    )


    vx = 0.0
    vy = 0.0
    vz = 0.0


    if ev and wv:

        mode = "DUAL"

        vx = float(
            ext.get(
                "proposed_vx_mm_s",
                0.0
            )
        )

        vy = float(
            wrist.get(
                "proposed_vy_mm_s",
                0.0
            )
        )

        ez = float(
            ext.get(
                "proposed_vz_mm_s",
                0.0
            )
        )

        wz = float(
            wrist.get(
                "proposed_vz_mm_s",
                0.0
            )
        )

        # If both cameras agree on Z:
        # wrist gets more fine-control weight.
        if (
            ez == 0.0
            or
            wz == 0.0
            or
            ez * wz > 0
        ):

            vz = (
                0.35 * ez
                +
                0.65 * wz
            )

        else:

            # Z disagreement:
            # keep External-X and Wrist-Y active,
            # and trust the external camera for Base-Z.
            #
            # Do NOT freeze X/Y and do NOT freeze Z.
            vz = ez

            mode = (
                "DUAL_Z_CONFLICT"
            )


    elif ev:

        mode = (
            "EXTERNAL_ONLY"
        )

        vx = float(
            ext.get(
                "proposed_vx_mm_s",
                0.0
            )
        )

        vy = 0.0

        vz = float(
            ext.get(
                "proposed_vz_mm_s",
                0.0
            )
        )


    elif wv:

        mode = (
            "WRIST_ONLY"
        )

        vx = 0.0

        vy = float(
            wrist.get(
                "proposed_vy_mm_s",
                0.0
            )
        )

        vz = float(
            wrist.get(
                "proposed_vz_mm_s",
                0.0
            )
        )


    else:

        # Both visual sources are currently invalid.
        #
        # Do NOT immediately inject (0,0,0) for a short
        # dropout.  Reuse the most recent VALID direction
        # at reduced speed.
        if last_valid_time is None:

            grace_age_s = float("inf")

        else:

            grace_age_s = (
                now
                -
                last_valid_time
            )


        if (
            0.0
            <= grace_age_s
            <= BLIND_GRACE_TIME_S
        ):

            mode = "BLIND_GRACE"

            vx = (
                last_valid_velocity[0]
                *
                BLIND_GRACE_SCALE
            )

            vy = (
                last_valid_velocity[1]
                *
                BLIND_GRACE_SCALE
            )

            vz = (
                last_valid_velocity[2]
                *
                BLIND_GRACE_SCALE
            )


            # Additional blind-motion vector limit.
            n = math.sqrt(
                vx*vx
                +
                vy*vy
                +
                vz*vz
            )

            if (
                n
                >
                BLIND_GRACE_MAX_SPEED_MM_S
                and
                n > 1e-9
            ):

                k = (
                    BLIND_GRACE_MAX_SPEED_MM_S
                    /
                    n
                )

                vx *= k
                vy *= k
                vz *= k

        else:

            mode = "STOP"

            vx = 0.0
            vy = 0.0
            vz = 0.0


    (
        vx,
        vy,
        vz
    ) = vector_limit(
        vx,
        vy,
        vz
    )


    # Update last known GOOD visual velocity only from an
    # actually valid visual mode.  BLIND_GRACE itself must
    # never refresh the grace timer.
    if mode in (
        "DUAL",
        "DUAL_Z_CONFLICT",
        "EXTERNAL_ONLY",
        "WRIST_ONLY",
    ):

        last_valid_time = now

        last_valid_velocity = (
            float(vx),
            float(vy),
            float(vz),
        )


    # ========================================================
    # ALWAYS SHADOW.
    #
    # proposed_* is diagnostic only.
    # actual enabled output remains false.
    # ========================================================

    out = {
        "timestamp":
            now,

        "enabled":
            False,

        "shadow_mode":
            True,

        "ready_for_motion":
            bool(
                ev
                or
                wv
                or
                mode == "BLIND_GRACE"
            ),

        "fusion_mode":
            mode,

        "external_valid":
            ev,

        "wrist_valid":
            wv,

        "external_age_s":
            (
                ea
                if math.isfinite(ea)
                else None
            ),

        "wrist_age_s":
            (
                wa
                if math.isfinite(wa)
                else None
            ),

        "proposed_vx_mm_s":
            float(vx),

        "proposed_vy_mm_s":
            float(vy),

        "proposed_vz_mm_s":
            float(vz),

        "external":
            ext,

        "wrist":
            wrist,
    }


    atomic(
        out
    )


    if mode != last_mode:

        print(
            "[WIRE GRASP FUSION]",
            last_mode,
            "->",
            mode,
            flush=True
        )

        last_mode = mode


    print(
        f"[{mode}] "
        f"EXT={'OK' if ev else 'NO'} "
        f"WRIST={'OK' if wv else 'NO'} "
        f"proposed="
        f"({vx:+.2f},"
        f"{vy:+.2f},"
        f"{vz:+.2f}) mm/s",
        flush=True
    )


    time.sleep(
        0.05
    )
